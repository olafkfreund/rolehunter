# Real .env is generated by scripts/setup.sh. This file documents the shape.

# Ports (scripts/setup.sh picks free random ones on first run).
APP_PORT=3000
DB_PORT=5432

# Postgres credentials used by docker-compose.
DB_PASSWORD=replace-me
DATABASE_URL=postgres://rolehunter:replace-me@db:5432/rolehunter

# API keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
JSEARCH_RAPIDAPI_KEY=
# LinkedIn Job Search API (Fantastic Jobs) — uses the same RapidAPI key above.
LINKEDIN_RAPIDAPI_HOST=linkedin-job-search-api.p.rapidapi.com

# Defaults.
DEFAULT_LLM_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-pro
